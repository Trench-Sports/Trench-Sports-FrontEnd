<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Privacy manifest for the App target.

  Required for App Store submission. Without it the upload comes back with
  ITMS-91053 ("Missing API declaration") and the build is rejected before a
  human ever sees it.

  Scope note: this file covers THIS target only. Capacitor ships its own
  manifests inside the CapacitorSPM / CapacitorCordova frameworks; Xcode
  aggregates every manifest in the bundle into the App Privacy report at
  archive time. Do not duplicate their declarations here.

  Keep this in sync with the App Privacy answers in App Store Connect. The two
  are checked against each other, and a mismatch is a rejection.

  NSPrivacyTracking is false and NSPrivacyTrackingDomains is empty because
  nothing here is shared with a data broker or joined to third-party data for
  advertising. Telemetry (src/lib/telemetry.ts) writes to our own Supabase
  app_events table. If an ad SDK or third-party analytics is ever added, this
  flips to true and the app must call ATTrackingManager first.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>

	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- Coach / staff account email. Supabase auth. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Athlete and coach names on the roster. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Supabase user id / program id carried on every session row. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- GPS fix taken once at session start to stamp where a session was
		     recorded. User-disableable in Session Settings. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePreciseLocation</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- In-app telemetry: screen and action events, batched to app_events. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Handled error reports (src/lib/errorReporting.tsx). -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCrashData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- The training measurements themselves: per-strike force, placement,
		     timing and Strength Index, tied to an athlete. Apple has no
		     purpose-built category for athletic performance data, so it is
		     declared under Other Data. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDataTypes</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- WKWebView-backed storage and Capacitor preferences both land in
		     UserDefaults. CA92.1 = read/write of values set by this app only. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>

		<!-- IndexedDB / WKWebView cache files written by the session outbox
		     and telemetry buffer. C617.1 = files created by this app. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>

		<!-- Deliberately NOT declared: DiskSpace and SystemBootTime.
		     The rule is to declare required-reason APIs this target actually
		     reaches. Under-declaring gets you ITMS-91053; over-declaring gets
		     you a reviewer asking where you use an API you cannot point at.
		     This target is an AppDelegate and a WKWebView — the two above are
		     the only required-reason categories it genuinely touches. If a
		     Capacitor plugin is added that reads disk space or boot time, the
		     plugin ships its own manifest and Xcode aggregates it; do not
		     pre-emptively add it here. -->
	</array>
</dict>
</plist>
