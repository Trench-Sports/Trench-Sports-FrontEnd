node_modules
dist
.DS_Store
*.log

# Per-developer Vite overrides (e.g. VITE_ACCEL_THRESH_MG) — .env itself is tracked
.env*.local

# Server-side tooling secrets — NEVER commit (holds SUPABASE_SERVICE_ROLE_KEY)
tools/.env
tools/.env.*

# ESP-IDF firmware build artifacts — generated, large, contain absolute-path
# symlinks that break `vite build` if committed. Keep only source under firmware-src/.
firmware-src/**/build/
**/build/esp-idf/
sdkconfig.old

# Local audit-agent output
.audit/

# Supabase CLI version-check cache
supabase/.temp/
.vercel
.env*
