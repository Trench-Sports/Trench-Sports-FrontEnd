{
  "name": "trench-sports-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "vercel-build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "cap:dev": "CAP_ENV=development cap sync ios",
    "cap:prod": "npm run build && cap sync ios",
    "cap:preview": "CAP_ENV=preview npm run build && CAP_ENV=preview cap sync ios",
    "ios:dev": "CAP_ENV=development cap sync ios && cap open ios",
    "ios:prod": "npm run build && cap sync ios && cap open ios",
    "ios:preview": "CAP_ENV=preview npm run build && CAP_ENV=preview cap sync ios && cap open ios",
    "typecheck": "tsc --noEmit",
    "audit": "node scripts/audit.mjs",
    "audit:working": "node scripts/audit.mjs --working",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-push": "npm run typecheck && node scripts/audit.mjs"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.0.1",
    "@capacitor/core": "^8.0.2",
    "@capacitor/ios": "^8.0.2",
    "@supabase/supabase-js": "^2.90.1",
    "compression": "^1.7.4",
    "dotenv": "^17.2.3",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-react": "^4.3.1",
    "playwright": "^1.62.1",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
